# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# Python packaging / build artifacts
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/

# Test, coverage, lint and type-check caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/
.cache/

# Jupyter / notebooks
.ipynb_checkpoints/

# Streamlit local secrets and runtime state
.streamlit/secrets.toml
.streamlit/config.toml

# Environment variables and local credentials
.env
.env.*
!.env.example
*.pem
*.key
*.crt
credentials.json
token.json

# Generated project data and reports
# Raw demo CSV files are intentionally kept in git: data/raw/*.csv
# Recreate these files with: python -m ru_liquidity_sentinel.cli run
/data/processed/*
!/data/processed/.gitkeep
/output/*
!/output/.gitkeep

# Logs and temporary files
*.log
logs/
tmp/
temp/
*.tmp

# OS files
.DS_Store
Thumbs.db

# IDE/editor files
.vscode/
.idea/
*.swp
*.swo

# Local archives
*.zip
*.tar.gz
*.7z
*.rar
